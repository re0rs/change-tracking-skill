{
  "version": "v1",
  "hooks": [
    {
      "name": "change-tracking-git-push",
      "description": "监听终端执行工具，检测 git push 命令并自动生成变更记录",
      "trigger": "PostToolUse",
      "matcher": "execute_pwsh|execute_bash",
      "action": {
        "type": "command",
        "command": "node scripts/check-git-push.js"
      },
      "timeout": 30
    }
  ]
}
